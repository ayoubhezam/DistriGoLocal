<?xml version="1.0" encoding="utf-8"?><!--
   Pre-Android-12 devices (API 30 and below). Android 12+ reads data_extraction_rules.xml, which
   carries the same exclusion and explains the reasoning.

   Entity photos in filesDir/images/ are excluded; the database is not. A dangling img: reference
   after a restore resolves to null and draws the placeholder, not a crash.
-->
<full-backup-content>
    <exclude domain="file" path="images" />
</full-backup-content>
